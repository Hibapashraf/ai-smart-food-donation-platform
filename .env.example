# Copy to .env. Keep .env out of source control.
# Generate a key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Leave DATABASE_URL unset for the local SQLite quick start.
# MySQL 8.0+ (URL-encode special characters in the username/password):
# DATABASE_URL=mysql+pymysql://foodconnect_app:YOUR_ENCODED_PASSWORD@127.0.0.1:3306/foodconnect?charset=utf8mb4

# Optional. Empty means public admin registration is disabled.
ADMIN_REGISTRATION_CODE=

# Optional browser API key, restricted to your website origin.
GOOGLE_MAPS_API_KEY=

# Enable only when the app is served over HTTPS.
COOKIE_SECURE=false
